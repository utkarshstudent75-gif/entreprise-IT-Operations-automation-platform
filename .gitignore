# Ignore Terraform local directories and caches
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan

# Ignore backup files
*~
*.bak

# Node modules and build artifacts
node_modules/
dist/

# Python Virtual Environments & Packages
.venv/
backend/.venv/
venv/
ENV/

# Python caching & bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Coverage & testing reports
.coverage
htmlcov/
coverage.xml
backend/coverage/
backend/.coverage

# Local environment configuration & archives
.env
*.env
.env.local
backend/.env
deploy.tar

# Bootstrap output and secrets files
bootstrap/.bootstrap-output.json
bootstrap/github-secrets.txt
