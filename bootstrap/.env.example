# ==============================================================================
# Enterprise IT Operations Automation Platform (EITOAP) - Bootstrap Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as necessary before running the scripts.
# E.g., cp bootstrap/.env.example bootstrap/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Settings
# ------------------------------------------------------------------------------
# Default project name prefix for resource naming and tagging
EITOAP_PROJECT_NAME="eitoap"

# Deployment environment (dev, test, prod)
EITOAP_ENVIRONMENT="dev"

# Target Azure region (must not be hardcoded, eastus is the default)
EITOAP_LOCATION="eastus"

# ------------------------------------------------------------------------------
# Terraform Backend Configuration
# ------------------------------------------------------------------------------
# Resource Group for the Terraform remote state storage account
EITOAP_BACKEND_RG="eitoap-tfstate-rg"

# Storage Account name (globally unique - if not unique, the bootstrap script will suffix it)
EITOAP_BACKEND_STORAGE="eitoaptfstate"

# Storage container name for the state file
EITOAP_BACKEND_CONTAINER="tfstate"

# ------------------------------------------------------------------------------
# Service Principal Configuration
# ------------------------------------------------------------------------------
# Name of the AD application / Service Principal to create/reuse for CI/CD
EITOAP_SP_NAME="eitoap-github"

# ------------------------------------------------------------------------------
# Azure Credentials (Sourced during execution or populated by bootstrap.sh)
# ------------------------------------------------------------------------------
# Azure Subscription ID
AZURE_SUBSCRIPTION_ID=""

# Azure Tenant ID
AZURE_TENANT_ID=""

# Client ID of the deployment Service Principal
AZURE_CLIENT_ID=""

# Client Secret of the deployment Service Principal (Sensitive)
AZURE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# GitHub OIDC Configuration
# ------------------------------------------------------------------------------
# GitHub repository (organization/repo) for federated identity credentials
# Used by azure/login@v2 in CI workflows to authenticate via OIDC without a client secret
EITOAP_GITHUB_REPOSITORY="utkarshstudent75-gif/entreprise-IT-Operations-automation-platform"

# Comma-separated list of branches to configure for OIDC federated identity
# The CI workflow triggers Azure Login on these branches
EITOAP_GITHUB_BRANCHES="master,main"

# Comma-separated list of GitHub events to configure for OIDC federated identity
# Used for workflow_dispatch and other non-ref events (e.g., workflow_dispatch)
# Leave empty if not needed
EITOAP_GITHUB_EVENTS="workflow_dispatch"
