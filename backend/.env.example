APP_NAME=Enterprise IT Operations Automation Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eitoap

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# SMS Notification Configuration
NOTIFICATION_PROVIDER=sms
# Actual secrets are stored in GitHub Actions secrets (CI) and Azure Key Vault (AKS).
# Contact the platform team for test credentials.
SMS_API_KEY=<your-sms-api-key>
SMS_ACCOUNT_SID=<your-sms-account-sid>
SMS_BASE_URL=https://od2.in/api/sms
SMS_SENDER_ID=+15551234567
SMS_TIMEOUT_SECONDS=5.0
SMS_RETRY_COUNT=3
SMS_TEST_RECIPIENT=+18005550199

# Microsoft Entra ID Integration
# Required for Graph API calls (user lookup, password reset, phone lookup)
# Leave blank to run in mock mode (local development)
ENTRA_TENANT_ID=<your-tenant-id>
ENTRA_CLIENT_ID=<your-client-id>
ENTRA_CLIENT_SECRET=<your-client-secret>
ENTRA_REDIRECT_URI=

# AI Operations Assistant (all Azure reads are limited to this subscription).
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=
OPS_AZURE_SUBSCRIPTION_ID=
# Set the deployed Azure Functions /api base URL; keep its key in Key Vault.
OPS_ASSISTANT_FUNCTIONS_BASE_URL=
# Shared secret for Azure Functions to deliver normalized Azure Monitor alerts.
OPS_ASSISTANT_ALERT_INGEST_TOKEN=
OPS_ASSISTANT_ALLOWED_ORIGINS=
