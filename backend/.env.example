APP_NAME=Enterprise IT Operations Automation Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eitoap

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# SMS Notification Configuration
NOTIFICATION_PROVIDER=sms
# Actual secrets are stored in GitHub Actions secrets (CI) and Azure Key Vault (AKS).
# Contact the platform team for test credentials.
SMS_API_KEY=<your-sms-api-key>
SMS_ACCOUNT_SID=<your-sms-account-sid>
SMS_BASE_URL=https://od2.in/api/sms
SMS_SENDER_ID=+15551234567
SMS_TIMEOUT_SECONDS=5.0
SMS_RETRY_COUNT=3
SMS_TEST_RECIPIENT=+18005550199
