      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "sum(rate(http_requests_total{job=\"eitoap-backend\",status=~\"4..|5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"eitoap-backend\"}[5m])), 0.001)", "legendFormat": "4xx + 5xx ratio", "refId": "A"}],
      "title": "HTTP error rate",
      "type": "timeseries"
    },
