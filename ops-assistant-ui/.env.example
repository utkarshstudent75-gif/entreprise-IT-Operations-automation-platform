VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ASSISTANT_API_SCOPE=api://<backend-app-registration-id>/access_as_user
VITE_ASSISTANT_API_URL=/api/v1
# For local development, the Vite proxy forwards /api to the FastAPI backend.
# For Static Web Apps, set VITE_ASSISTANT_API_URL to the HTTPS backend API base.
